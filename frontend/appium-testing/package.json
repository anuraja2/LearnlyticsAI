    "test:sos": "mocha tests/04_emergency_sos.test.js --timeout 60000"
  },
  "dependencies": {
    "webdriverio": "^8.38.0",
    "exceljs": "^4.4.0",
    "mocha": "^10.4.0",
    "chai": "^4.4.1"
  }
}
