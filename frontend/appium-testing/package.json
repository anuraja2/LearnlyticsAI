{
  "name": "smartchild-appium-testing",
  "version": "1.0.0",
  "description": "Appium End-to-End Mobile Testing Suite for SmartChild AI Android App with Excel Reporting",
  "main": "index.js",
  "scripts": {
    "test": "mocha tests/**/*.test.js --timeout 120000",
    "test:e2e": "node runner.js",
    "test:auth": "mocha tests/01_auth.test.js --timeout 60000",
    "test:child": "mocha tests/02_child_learning.test.js --timeout 90000",
