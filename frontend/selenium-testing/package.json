{
  "name": "smartchild-selenium-testing",
  "version": "1.0.0",
  "description": "Selenium Web Application End-to-End Testing Suite for SmartChild AI with Excel Analysis Reporting in Node.js",
  "main": "runner.js",
  "scripts": {
    "test": "node runner.js",
    "test:mocha": "mocha tests/**/*.test.js --timeout 120000",
    "test:auth": "mocha tests/01_auth.test.js --timeout 60000",
    "test:child": "mocha tests/02_child_dashboard.test.js --timeout 90000",
    "test:parent": "mocha tests/05_parent_dashboard.test.js --timeout 90000"
  },
  "dependencies": {
    "selenium-webdriver": "^4.20.0",
    "chromedriver": "^124.0.0",
    "exceljs": "^4.4.0",
    "mocha": "^10.4.0",
    "chai": "^4.4.1"
  }
}
